# Copy to .env for local work, and set both in the Vercel project settings
# before the first deploy. Setting them late is the most common way a deploy
# evening goes wrong.
#
# There is no weather API key. Weather comes from Open-Meteo, which needs no
# account and no key at all.

# Neon Postgres. Use the POOLED connection string from the Neon dashboard.
# Leave this unset locally to run against PGlite in ./.pglite instead, which
# needs no account and no network.
DATABASE_URL=

# Any long random string. Required before /api/seed will touch a live database.
SEED_TOKEN=

# Optional. Sarvam AI speech-to-text, for better code-mixed Hindi and Marathi.
# Leave unset and voice falls back to the browser's own recogniser, which needs
# no key and is the path that has actually been tested.
SARVAM_API_KEY=
