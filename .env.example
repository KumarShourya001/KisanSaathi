# Copy to .env for local work, and set the same three in the Vercel project
# settings before the first deploy. Setting them late is the single most common
# way a deploy evening goes wrong.

# Neon Postgres. Use the POOLED connection string from the Neon dashboard.
# Leave this unset locally to run against PGlite in ./.pglite instead, which
# needs no account and no network.
DATABASE_URL=

# OpenWeather free tier. Register this first: a new key can take up to an hour
# to activate, and nothing else on the critical path has a clock on it.
OPENWEATHER_KEY=

# Any long random string. Required before /api/seed will touch a live database.
SEED_TOKEN=
